{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/assets/models/**",
        "destination": "/assets/assets/models/**"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
